<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.easyout.backup</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/annyang/Projects/EasyOut/scripts/backup-supabase.sh</string>
	</array>

	<!-- Sundays at 10:00 local time. If the Mac is asleep, launchd runs it on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/annyang/EasyOut-backups/backup.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/annyang/EasyOut-backups/backup.log</string>
</dict>
</plist>
